# Copy to test/.env to run `npm run test:integration`.
# Each backend spec is skipped unless the Hiero network values and that
# backend's key variable are set.

# JSON map of node address to node account ID (local Solo network shown)
HIERO_NETWORK={"127.0.0.1:50211":"0.0.3"}
# Funded account used to create the test account owned by the remote key
HIERO_OPERATOR_ID=0.0.2
# Private key of that account (a local test key only)
HIERO_OPERATOR_KEY=
# Encoding of HIERO_OPERATOR_KEY: der (default), ecdsa or ed25519
HIERO_OPERATOR_KEY_TYPE=der
# --- AWS KMS ---
# Key with spec ECC_SECG_P256K1 or ECC_NIST_EDWARDS25519
AWS_KMS_KEY_ID=
# Standard AWS SDK settings
AWS_REGION=eu-central-1
# AWS_PROFILE=

# --- Google Cloud KMS ---
# Full key version name with algorithm EC_SIGN_SECP256K1_SHA256 or EC_SIGN_ED25519,
# e.g. projects/p/locations/l/keyRings/r/cryptoKeys/k/cryptoKeyVersions/1
GCP_KMS_KEY_VERSION=
# Credentials come from Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Azure Key Vault / Managed HSM ---
# Versioned key identifier of an EC or EC-HSM key on curve P-256K,
# e.g. https://my-vault.vault.azure.net/keys/hiero-treasury/<version>
AZURE_KEY_VAULT_KEY_ID=
# Credentials come from DefaultAzureCredential (environment, managed identity, Azure CLI, ...)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- HashiCorp Vault / OpenBao transit ---
# With only VAULT_ADDR and VAULT_TOKEN set (e.g. `vault server -dev`), the spec
# mounts transit, creates its own ed25519 keys and checks signatures locally.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
# VAULT_TRANSIT_MOUNT=transit
# Existing ed25519 transit key for the live Hiero network test
VAULT_TRANSIT_KEY=

# --- PKCS#11 (HSM or SoftHSM) ---
# With the library, token label and PIN set, the spec generates its own
# secp256k1 and Ed25519 key pairs on the token. Initialize a SoftHSM token with:
#   softhsm2-util --init-token --free --label hiero --pin 1234 --so-pin 5678
PKCS11_LIBRARY=/usr/lib/softhsm/libsofthsm2.so
PKCS11_TOKEN_LABEL=hiero
PKCS11_PIN=
# Existing key pair label for the live Hiero network test
PKCS11_KEY_LABEL=
