# Copy to test/.env to run `npm run test:integration`.
# Each backend spec is skipped unless the Hiero network values and that
# backend's key variable are set.

# JSON map of node address to node account ID (local Solo network shown)
HIERO_NETWORK={"127.0.0.1:50211":"0.0.3"}
# Funded account used to create the test account owned by the remote key
HIERO_OPERATOR_ID=0.0.2
# Private key of that account (a local test key only)
HIERO_OPERATOR_KEY=
# Encoding of HIERO_OPERATOR_KEY: der (default), ecdsa or ed25519
HIERO_OPERATOR_KEY_TYPE=der
# --- AWS KMS ---
# Key with spec ECC_SECG_P256K1 or ECC_NIST_EDWARDS25519
AWS_KMS_KEY_ID=
# Standard AWS SDK settings
AWS_REGION=eu-central-1
# AWS_PROFILE=

# --- Google Cloud KMS ---
# Full key version name with algorithm EC_SIGN_SECP256K1_SHA256 or EC_SIGN_ED25519,
# e.g. projects/p/locations/l/keyRings/r/cryptoKeys/k/cryptoKeyVersions/1
GCP_KMS_KEY_VERSION=
# Credentials come from Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=
