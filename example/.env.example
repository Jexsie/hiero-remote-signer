# Copy to example/.env and fill in. example/.env is git-ignored.

# --- Your testnet account ---
# From portal.hedera.com. It pays to create the remote-key account and pays
# the fee of the co-signed transfer. Its key stays on this machine.
FUNDING_ACCOUNT_ID=0.0.
FUNDING_PRIVATE_KEY=
# Encoding of FUNDING_PRIVATE_KEY: ecdsa (hex, the portal default), ed25519 or der
FUNDING_KEY_TYPE=ecdsa

# --- Remote signer ---
# Fill in only the section of the backend you run (npm run aws|gcp|azure|vault|pkcs11).

# --- AWS KMS ---
# Key ID, ARN or alias of a key with spec ECC_SECG_P256K1 or ECC_NIST_EDWARDS25519
AWS_KMS_KEY_ID=alias/hiero-operator
AWS_REGION=eu-central-1
# AWS_PROFILE=hiero-signer

# --- Google Cloud KMS ---
# Key version with algorithm EC_SIGN_SECP256K1_SHA256 (HSM) or EC_SIGN_ED25519
GCP_KMS_KEY_VERSION=projects/<project>/locations/europe-west1/keyRings/hiero/cryptoKeys/hiero-operator/cryptoKeyVersions/1
# Uses Application Default Credentials (`gcloud auth application-default login`)
# GOOGLE_APPLICATION_CREDENTIALS=

# --- Azure Key Vault ---
# Versioned key identifier of an EC or EC-HSM key on curve P-256K
AZURE_KEY_VAULT_KEY_ID=https://<vault-name>.vault.azure.net/keys/hiero-operator/<version>
# Uses DefaultAzureCredential (`az login`, environment variables, managed identity)

# --- HashiCorp Vault / OpenBao transit ---
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_TRANSIT_KEY=hiero-operator

# --- PKCS#11 (SoftHSM or a hardware HSM) ---
# Homebrew on Apple silicon; /usr/local/lib/softhsm/... on Intel Macs,
# /usr/lib/softhsm/libsofthsm2.so on Debian and Ubuntu
PKCS11_LIBRARY=/opt/homebrew/lib/softhsm/libsofthsm2.so
PKCS11_TOKEN_LABEL=hiero
PKCS11_PIN=
PKCS11_KEY_LABEL=hiero-operator
# Curve used when `npm run pkcs11` generates the key pair: secp256k1 or ed25519
PKCS11_KEY_CURVE=secp256k1
