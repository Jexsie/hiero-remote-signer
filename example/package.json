{
    "name": "hiero-remote-signer-example",
    "version": "0.0.0",
    "private": true,
    "description": "Create and use a Hiero testnet account whose key lives in a remote signer",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=20.12"
    },
    "scripts": {
        "show-key": "tsx src/show-key.ts",
        "create-account": "tsx src/create-account.ts",
        "transfer": "tsx src/transfer.ts",
        "co-sign": "tsx src/co-sign.ts",
        "pkcs11:keygen": "tsx src/pkcs11-keygen.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@aws-sdk/client-kms": "^3.1149.0",
        "@azure/identity": "^4.13.3",
        "@azure/keyvault-keys": "^4.10.2",
