# Copy to test/.env to run `npm run test:integration`.
# The integration spec is skipped unless all four values are set.

# JSON map of node address to node account ID (local Solo network shown)
HIERO_NETWORK={"127.0.0.1:50211":"0.0.3"}
# Funded account used to create the KMS-owned test account
HIERO_OPERATOR_ID=0.0.2
# Private key of that account (a local test key only)
HIERO_OPERATOR_KEY=
# Encoding of HIERO_OPERATOR_KEY: der (default), ecdsa or ed25519
HIERO_OPERATOR_KEY_TYPE=der
# KMS key with spec ECC_SECG_P256K1 or ECC_NIST_EDWARDS25519
AWS_KMS_KEY_ID=

# Standard AWS SDK settings
AWS_REGION=eu-central-1
# AWS_PROFILE=
