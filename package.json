{
    "name": "hiero-remote-signer",
    "version": "0.1.0",
    "description": "Sign Hiero network transactions with keys held in a cloud KMS. Private keys never leave the KMS.",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./aws": {
            "import": {
                "types": "./dist/aws/index.d.ts",
                "default": "./dist/aws/index.js"
            },
            "require": {
                "types": "./dist/aws/index.d.cts",
                "default": "./dist/aws/index.cjs"
            }
        },
        "./azure": {
            "import": {
                "types": "./dist/azure/index.d.ts",
                "default": "./dist/azure/index.js"
            },
            "require": {
                "types": "./dist/azure/index.d.cts",
                "default": "./dist/azure/index.cjs"
            }
        },
        "./gcp": {
            "import": {
                "types": "./dist/gcp/index.d.ts",
                "default": "./dist/gcp/index.js"
            },
            "require": {
                "types": "./dist/gcp/index.d.cts",
                "default": "./dist/gcp/index.cjs"
            }
        },
        "./pkcs11": {
            "import": {
                "types": "./dist/pkcs11/index.d.ts",
                "default": "./dist/pkcs11/index.js"
            },
            "require": {
                "types": "./dist/pkcs11/index.d.cts",
                "default": "./dist/pkcs11/index.cjs"
            }
        },
        "./vault": {
            "import": {
                "types": "./dist/vault/index.d.ts",
                "default": "./dist/vault/index.js"
            },
            "require": {
                "types": "./dist/vault/index.d.cts",
                "default": "./dist/vault/index.cjs"
            }
        }
    },
    "keywords": [
        "hiero",
        "dlt",
        "kms",
        "hsm",
        "aws-kms",
        "signer",
        "secp256k1",
        "ed25519",
        "gcp-kms",
        "google-cloud-kms",
        "remote-signer",
        "azure-key-vault",
        "hashicorp-vault",
        "openbao",
        "pkcs11",
        "softhsm"
    ],
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "workspaces": [
        "example"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "prepare": "husky && npm run build",
        "build": "npm run build:test && npm run clean && npm run build:compile",
        "build:compile": "node node_modules/typescript-7/bin/tsc -p tsconfig.json && babel src -d dist --extensions .ts --out-file-extension .cjs --source-maps && node scripts/generate-cts-declarations.js dist",
        "build:test": "node node_modules/typescript-7/bin/tsc --noEmit -p test/tsconfig.test.json",
        "clean": "rm -rf dist",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:unit": "node node_modules/typescript-7/bin/tsc --noEmit -p test/tsconfig.test.json && vitest run -c test/vitest.config.ts",
        "test:unit:coverage": "node node_modules/typescript-7/bin/tsc --noEmit -p test/tsconfig.test.json && vitest run -c test/vitest.config.ts --coverage",
        "test:integration": "vitest run -c test/vitest-integration.config.ts",
        "test:integration:coverage": "vitest run -c test/vitest-integration.config.ts --coverage",
        "test": "npm run test:unit && npm run test:integration",
        "test:watch": "vitest -c test/vitest.config.ts"
    },
    "dependencies": {
        "@noble/hashes": "^2.4.0"
    },
    "peerDependencies": {
        "@aws-sdk/client-kms": "^3.1149.0",
        "@azure/keyvault-keys": "^4.10.2",
        "@google-cloud/kms": "^6.2.1",
        "@hiero-ledger/sdk": "^2.89.0",
        "pkcs11js": "^2.1.7"
    },
    "peerDependenciesMeta": {
        "@aws-sdk/client-kms": {
            "optional": true
        },
        "@azure/keyvault-keys": {
            "optional": true
        },
        "@google-cloud/kms": {
            "optional": true
        },
        "pkcs11js": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@aws-sdk/client-kms": "^3.1149.0",
        "@azure/identity": "^4.13.3",
        "@azure/keyvault-keys": "^4.10.2",
        "@babel/cli": "^8.0.6",
        "@babel/core": "^8.0.7",
        "@babel/plugin-transform-modules-commonjs": "^8.0.1",
        "@babel/preset-typescript": "^8.0.7",
        "@eslint/js": "^10.0.1",
        "@google-cloud/kms": "^6.2.1",
        "@hiero-ledger/sdk": "^2.89.1",
        "@noble/curves": "^2.4.0",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.3",
        "aws-sdk-client-mock": "^4.1.0",
        "babel-plugin-module-rewrite": "^0.2.0",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "pkcs11js": "^2.1.7",
        "prettier": "^3.9.9",
        "typescript": "~6.0.3",
        "typescript-7": "npm:typescript@^7.0.2",
        "typescript-eslint": "^8.71.2",
        "vitest": "^5.0.3"
    },
    "lint-staged": {
        "*.{ts,js,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,yml,yaml}": "prettier --write"
    }
}
